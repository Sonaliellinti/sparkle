# ── Database ──────────────────────────────────────────────────────────────
# Local development (SQLite file, created automatically):
DATABASE_URL=sqlite:///./jee_diagnosis.db

# Production (Supabase / any Postgres) — just swap this one value:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>

# ── Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── AI / Groq (used starting Phase 3 — safe to leave blank for now) ───────
# If left empty, the backend automatically falls back to deterministic
# mock responses so the app runs fully offline.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── App metadata ──────────────────────────────────────────────────────────
APP_NAME=Sparkle
ENVIRONMENT=development
